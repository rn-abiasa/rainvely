{
  "name": "rainvely",
  "version": "0.1.0",
  "description": "A soft, cozy rain overlay for React. It fills its parent and stays out of the way.",
  "keywords": ["react", "rain", "overlay", "canvas", "animation", "cozy", "weather"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/rainvely.cjs",
  "module": "./dist/rainvely.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/rainvely.js",
      "require": "./dist/rainvely.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:demo": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
